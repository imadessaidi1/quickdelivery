FROM maven:3.9.9-eclipse-temurin-21 AS build

ARG MODULE

WORKDIR /workspace

COPY pom.xml ./
COPY quickdemivery-config-server/pom.xml quickdemivery-config-server/pom.xml
COPY quickdelivery-registy-server/pom.xml quickdelivery-registy-server/pom.xml
COPY oauth-authorization-server/pom.xml oauth-authorization-server/pom.xml
COPY quickdelivery-api-gateway/pom.xml quickdelivery-api-gateway/pom.xml
COPY quickdelivery-users/pom.xml quickdelivery-users/pom.xml
COPY quickdelivery-packages/pom.xml quickdelivery-packages/pom.xml
COPY quickdelivery-abstarct-dao/pom.xml quickdelivery-abstarct-dao/pom.xml
COPY quickdelivery-shipment/pom.xml quickdelivery-shipment/pom.xml
COPY quickdelivery-batches/pom.xml quickdelivery-batches/pom.xml

COPY . .

RUN mvn -pl ${MODULE} -am clean package -DskipTests && \
    cp "$(find /workspace/${MODULE}/target -maxdepth 1 -type f -name '*.jar' ! -name '*.jar.original' | head -n 1)" /tmp/app.jar

FROM eclipse-temurin:21-jre

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /tmp/app.jar /app/app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]

