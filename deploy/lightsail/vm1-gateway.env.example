CONFIG_SERVER_USERNAME=
CONFIG_SERVER_PASSWORD=
GATEWAY_INTERNAL_TOKEN=

API_GATEWAY_JAVA_TOOL_OPTIONS=-XX:+UseG1GC -XX:InitialRAMPercentage=20 -XX:MaxRAMPercentage=50 -XX:+UseStringDeduplication -XX:MaxGCPauseMillis=200
VM1_LIMIT_CONN_PER_IP=40
VM1_WS_LIMIT_CONN_PER_IP=6
VM1_API_PUBLIC_RATE=20r/s
VM1_API_PUBLIC_BURST=40
VM1_AUTH_PUBLIC_RATE=10r/s
VM1_AUTH_PUBLIC_BURST=20
VM1_TRACKING_PUBLIC_RATE=15r/s
VM1_TRACKING_PUBLIC_BURST=30
VM1_STATIC_CACHE_EXPIRES=7d
