QUICKDELIVERY_FRONTEND_LOCAL_HTTPS_URL=https://localhost
QUICKDELIVERY_FRONTEND_LOCAL_HTTP_ALT_URL=http://localhost:8080
QUICKDELIVERY_FRONTEND_LOCAL_HTTPS_ALT_URL=https://localhost:8080
REDIS_HOST=10.0.2.10
REDIS_PORT=6379
MYSQL_HOST=10.0.5.10
MYSQL_PORT=3306

USERS_SERVICE_VM3_URL=http://10.0.3.10:8081
USERS_SERVICE_VM4_URL=http://10.0.4.10:8081
PACKAGES_SERVICE_VM3_URL=http://10.0.3.10:8082
PACKAGES_SERVICE_VM4_URL=http://10.0.4.10:8082
