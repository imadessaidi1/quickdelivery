KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_DEBUG=false

GOOGLE_MAPS_KEY=
MAPQUEST_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=
QUICKDELIVERY_SECURITY_CAPTCHA_ENABLED=true
QUICKDELIVERY_SECURITY_CAPTCHA_PROVIDER=turnstile
QUICKDELIVERY_SECURITY_CAPTCHA_TURNSTILE_SECRET_KEY=CHANGE_ME_TURNSTILE_SECRET_KEY
QUICKDELIVERY_OCR_TEXTRACT_ENABLED=true
QUICKDELIVERY_OCR_TEXTRACT_REGION=eu-west-3

USERS_DOCS_MODE=s3
PACKAGES_DOCS_MODE=s3
