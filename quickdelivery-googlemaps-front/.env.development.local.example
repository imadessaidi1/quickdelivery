# VUE_APP_GATEWAY_BASE_URL=https://192.168.1.25:8443
# VUE_APP_AUTH_BASE_URL=https://192.168.1.25:18443/auth
# VUE_APP_WS_BASE_URL=wss://192.168.1.25:8443/ws
